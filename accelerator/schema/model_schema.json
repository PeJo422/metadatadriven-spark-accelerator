{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metadata SQL model schema v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "source",
    "target",
    "scd_type",
    "primary_key",
    "columns"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "alias"],
      "properties": {
        "table": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table"],
      "properties": {
        "table": { "type": "string", "minLength": 1 }
      }
    },
    "scd_type": {
      "enum": [1]
    },
    "primary_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "business_key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "incremental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "column": { "type": "string", "minLength": 1 },
        "type": { "enum": ["int", "bigint", "date", "datetime"] }
      }
    },
    "row_hash_columns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "row_filters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["column", "operator"],
        "properties": {
          "column": { "type": "string", "minLength": 1 },
          "operator": { "enum": ["is_null", "equals", "not_equals"] },
          "value": {}
        }
      }
    },
    "joins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "alias", "type", "on"],
        "properties": {
          "table": { "type": "string", "minLength": 1 },
          "alias": { "type": "string", "minLength": 1 },
          "type": { "enum": ["inner", "left", "right", "full"] },
          "on": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["left_alias", "left_column", "right_column"],
              "properties": {
                "left_alias": { "type": "string", "minLength": 1 },
                "left_column": { "type": "string", "minLength": 1 },
                "right_column": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "enum": ["string", "int", "bigint", "date", "datetime"]
          }
        }
      }
    }
  }
}
